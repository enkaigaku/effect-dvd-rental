{
  "name": "effect-dvd-rental",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --minify --packages=external",
    "start": "bun run dist/main.js",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "docker:build": "docker build -t effect-dvd-rental .",
    "docker:run": "docker run -p 8080:8080 --env-file .env effect-dvd-rental",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "migrate": "bun src/scripts/migrate.ts"
  },
  "dependencies": {
    "@effect/opentelemetry": "^4.0.1",
    "@effect/platform-bun": "^4.0.1",
    "@effect/sql-pg": "^4.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "bcrypt": "^6.0.0",
    "effect": "^4.0.1",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.1.14",
    "typescript": "^7.0.2"
  }
}
