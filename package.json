{
  "name": "effect-dvd-rental",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --minify --packages=external",
    "start": "bun run dist/main.js",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "docker:build": "docker build -t effect-dvd-rental .",
    "docker:run": "docker run -p 8080:8080 --env-file .env effect-dvd-rental",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "migrate": "bun src/scripts/migrate.ts"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.60.0",
    "@effect/platform": "^0.94.1",
    "@effect/platform-bun": "^0.87.0",
    "@effect/schema": "^0.75.5",
    "@effect/sql": "^0.49.0",
    "@effect/sql-pg": "^0.50.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "bcrypt": "^6.0.0",
    "effect": "^3.19.14",
    "jose": "^6.1.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
